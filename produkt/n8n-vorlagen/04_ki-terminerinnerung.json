{
  "name": "04 - KI Terminerinnerung",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 7 * * *" }]
        }
      },
      "id": "schedule",
      "name": "Täglich 07:00 Uhr",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": { "mode": "list", "value": "primary" },
        "timeMin": "={{ $now.plus({days: 1}).startOf('day').toISO() }}",
        "timeMax": "={{ $now.plus({days: 1}).endOf('day').toISO() }}",
        "options": { "singleEvents": true }
      },
      "id": "get-events",
      "name": "Termine morgen abrufen",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [440, 300],
      "notes": "Google-Kalender-Zugang nach Import verbinden. Kalender-ID auf den betrieblichen Terminkalender anpassen."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.extendedProperties?.private?.telefonnummer }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-hat-telefon",
      "name": "Telefonnummer hinterlegt?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 300],
      "notes": "Erwartet, dass die Kundentelefonnummer als Zusatzfeld im Kalendereintrag hinterlegt ist (z.B. per Angebots-/Terminsoftware)."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v20.0/PHONE_NUMBER_ID/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": {{ JSON.stringify($json.extendedProperties.private.telefonnummer) }},\n  \"type\": \"text\",\n  \"text\": { \"body\": \"Guten Tag, kurze Erinnerung: Morgen sind wir bei Ihnen für '{{ $json.summary }}' im Einsatz. Bei Fragen einfach antworten.\" }\n}",
        "options": {}
      },
      "id": "whatsapp-send",
      "name": "WhatsApp-Erinnerung senden",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 220],
      "notes": "WhatsApp Business API Zugangsdaten und Absender-Nummer (PHONE_NUMBER_ID) nach Import hinterlegen. Alternativ auf SMS-Anbieter umstellen."
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "mode": "list", "value": "SPREADSHEET_ID" },
        "sheetName": { "mode": "list", "value": "Erinnerungen-Log" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Termin": "={{ $json.summary }}",
            "Gesendet_an": "={{ $json.extendedProperties.private.telefonnummer }}",
            "Zeitpunkt": "={{ $now.toISO() }}"
          }
        },
        "options": {}
      },
      "id": "log-sheet",
      "name": "Versand protokollieren",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [880, 400]
    }
  ],
  "connections": {
    "Täglich 07:00 Uhr": { "main": [[{ "node": "Termine morgen abrufen", "type": "main", "index": 0 }]] },
    "Termine morgen abrufen": { "main": [[{ "node": "Telefonnummer hinterlegt?", "type": "main", "index": 0 }]] },
    "Telefonnummer hinterlegt?": { "main": [[{ "node": "WhatsApp-Erinnerung senden", "type": "main", "index": 0 }, { "node": "Versand protokollieren", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": {
    "templateSource": "KI-Kompass Handwerk & GaLaBau - Praxis-Leitfaden",
    "beschreibung": "Vorlage: Prüft täglich morgens die Termine des Folgetags und verschickt automatisch eine WhatsApp-Erinnerung an die Kundschaft — weniger verpasste Termine, weniger Rückfragen."
  }
}
