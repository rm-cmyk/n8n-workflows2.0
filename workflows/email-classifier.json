    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Emit one item per PDF/JPEG attachment from the trigger.\n// Trigger keeps binary under keys like 'attachment_0', 'attachment_1', ...\nconst trigger = $('Outlook Trigger (Posteingang)').first();\nconst triggerBinary = trigger.binary || {};\nconst out = [];\nfor (const item of $input.all()) {\n  const cardId = item.json.id || item.json.cardId;\n  for (const key of Object.keys(triggerBinary)) {\n    if (!key.toLowerCase().startsWith('attachment')) continue;\n    const b = triggerBinary[key];\n    const mime = (b.mimeType || '').toLowerCase();\n    const name = (b.fileName || '').toLowerCase();\n    const isPdf = mime.includes('pdf') || name.endsWith('.pdf');\n    const isJpeg = mime.includes('jpeg') || mime.includes('jpg') || name.endsWith('.jpg') || name.endsWith('.jpeg');\n    if (!isPdf && !isJpeg) continue;\n    out.push({\n      json: { cardId, fileName: b.fileName || key },\n      binary: { data: b }\n    });\n  }\n}\nreturn out;"
      },
