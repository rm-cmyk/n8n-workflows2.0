    {
      "parameters": {
        "inputText": "=Betreff: {{ $json.subject }}\nVon: {{ $json.from?.emailAddress?.name }} <{{ $json.from?.emailAddress?.address }}>\nAnhaenge: {{ ($json.hasAttachments ? 'ja' : 'nein') }}\n\n---\n{{ ($json.bodyPreview || '') }}\n\n{{ ($json.body?.content || '').toString().replace(/<[^>]+>/g, ' ').slice(0, 4000) }}",
        "categories": {
          "categories": [
            {
              "category": "Kundenanfragen",
              "description": "Anfragen von (potenziellen) Privatkunden: Produktfragen, Angebote, Support, Beschwerden, Terminanfragen. Meist persoenlich formuliert. KEINE Rechnungen."
            },
            {
              "category": "Lieferantenanfragen",
              "description": "Nachrichten von Lieferanten, Grosshaendlern oder B2B-Partnern: Angebote, Preislisten, Lieferbestaetigungen, Produktneuheiten. KEINE Rechnungen."
            },
            {
              "category": "Bewerbungen",
              "description": "Jobbewerbungen mit oder ohne Anhang: Anschreiben, Lebenslauf, Zeugnisse, Initiativbewerbungen, Praktikumsanfragen."
            },
            {
              "category": "SpamWerbung",
              "description": "Unaufgeforderte Werbung, Marketing-Newsletter, Massenmails, Phishing, SEO-/Backlink-Angebote, offensichtlicher Spam."
            },
            {
              "category": "Rechnungen",
              "description": "Eingehende Rechnungen, Gutschriften, Mahnungen, Zahlungserinnerungen. Oft mit PDF-Anhang und Stichworten wie 'Rechnung', 'Invoice', 'Beleg-Nr', 'Faellig'."
            }
          ]
        },
        "options": {
          "fallback": "other",
          "systemPromptTemplate": "Du bist ein Klassifikator fuer eingehende Geschaeftsmails. Ordne die Mail GENAU einer Kategorie zu. Wenn keine Kategorie eindeutig passt, gib 'other' zurueck. Antworte knapp und deterministisch.",
          "multiClass": false
        }
      },
