    {
      "parameters": {
        "inputText": "=Postfach: {{ $json.mailboxUpn }}\nBetreff: {{ $json.subject }}\nVon: {{ $json.from?.emailAddress?.name }} <{{ $json.from?.emailAddress?.address }}>\nAn: {{ ($json.toRecipients || []).map(r => r.emailAddress?.address).join(', ') }}\nAnhaenge: {{ ($json.hasAttachments ? 'ja' : 'nein') }}\n\n---\n{{ ($json.bodyPreview || '') }}\n\n{{ ($json.body?.content || '').toString().replace(/<[^>]+>/g, ' ').slice(0, 4000) }}",
        "categories": {
          "categories": [
            {
              "category": "01_Bauvorhaben",
              "description": "Mails zu konkreten Bauprojekten und Baustellen: Ausschreibungen, Leistungsverzeichnisse (LV), Aufmasse, Bauzeitenplaene, Baubesprechungen/Protokolle, Architekten, Statiker, Planung, Bauantraege/Genehmigungen, Bautagebuch, Nachtraege, Abnahmen, VOB. Erkennbar oft an Projektnummern, Bauvorhaben-Bezeichnungen, Strassen/Ortsangaben."
            },
            {
              "category": "02_Kunden",
              "description": "Kommunikation mit (potenziellen) Privat- oder Geschaeftskunden ausserhalb laufender Bauvorhaben: Anfragen, Angebote, Auftragsbestaetigungen, Service & Wartung (SW), Beschwerden, Reklamationen, Terminanfragen, Garantie. KEINE Rechnungen (-> 07), KEINE Bauprojekt-Korrespondenz (-> 01)."
            },
            {
              "category": "03_Lieferanten",
              "description": "B2B-Korrespondenz mit Lieferanten, Grosshaendlern, Herstellern, Subunternehmern und Partnern: Angebote/Preislisten, Bestell- und Lieferbestaetigungen, Versandavisen, Produktneuheiten, Konditionen, Kataloge, Partner-Newsletter mit fachlichem Bezug. KEINE Rechnungen (-> 07)."
            },
            {
              "category": "04_Intern",
              "description": "Interne Kommunikation, HR und Mitarbeiterthemen: Teaminfos, Urlaubsantraege, Krankmeldungen, Dienstplaene, Mitarbeitergespraeche, Onboarding, Personalakte, Bewerbungen, interne Ankuendigungen, Geburtstage, Firmenfeiern. Absender meist eine interne Domain oder Mitarbeiter."
            },
            {
              "category": "05_IT",
              "description": "IT- und Systemthemen: Microsoft 365/Google Workspace, Hosting, Domains/SSL, ERP/CRM, Software-Lizenzen und -Abos, Updates/Patches, Hardware-Bestellungen, Drucker/Telefonie, Sicherheitswarnungen, Passwort-Resets, MFA, IT-Dienstleister, Monitoring-Alerts."
            },
            {
              "category": "06_Schulungen",
              "description": "Aus- und Weiterbildung: Seminareinladungen, Webinare, Zertifikate, Schulungsanmeldungen und -bestaetigungen, IHK/HWK, Sicherheitsunterweisungen, Konferenzen, Fachveranstaltungen, Kursunterlagen."
            },
            {
              "category": "07_Buchhaltung",
              "description": "Alles Finanzielle: eingehende und ausgehende Rechnungen, Gutschriften, Mahnungen, Zahlungserinnerungen, Kontoauszuege, Steuerthemen/Steuerberater, Lohn/Gehalt, DATEV, SEPA, Versicherungen mit Zahlungsbezug. Stichworte: 'Rechnung', 'Invoice', 'Beleg-Nr', 'faellig', 'Mahnung'."
            },
            {
              "category": "08_Sonstiges",
              "description": "Alles, was nicht eindeutig in 01-07 passt: Werbung/Newsletter ohne Fachbezug, Spam, Phishing, allgemeine Anfragen, Pressemitteilungen, Umfragen, Politik/Verbaende ohne Schulungs-/Finanzbezug. Auch Fallback bei Unsicherheit."
            }
          ]
        },
        "options": {
          "fallback": "other",
          "systemPromptTemplate": "Du bist ein Klassifikator fuer eingehende Geschaeftsmails eines Bau-/Handwerksbetriebs. Ordne jede Mail GENAU EINER der 8 Kategorien zu. Lies Betreff, Absender, Empfaenger und Body sorgfaeltig. Bei Unsicherheit waehle '08_Sonstiges'. Antworte deterministisch, KEINE Erklaerungen.",
          "multiClass": false
        }
      },
      "id": "20000000-0000-0000-0000-000000000002",
      "name": "Text Classifier",
      "type": "@n8n/n8n-nodes-langchain.textClassifier",
      "typeVersion": 1.1,
      "position": [80, 120],
      "onError": "continueErrorOutput"
    },

