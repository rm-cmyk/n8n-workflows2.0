# n8n-mcp Server Configuration
# Copy this file to `.env` and fill in your values.
# Docs: https://github.com/czlonkowski/n8n-mcp

# URL deiner n8n-Instanz (optional, fuer Workflow-Management via API)
# Beispiele:
#   - Hosted:     https://your-n8n-instance.com
#   - Docker/Lokal: http://localhost:5678
#   - Docker (von Host aus Container): http://host.docker.internal:5678
N8N_API_URL=

# API-Key aus n8n (Settings -> API)
N8N_API_KEY=

# MCP-Modus (fuer Claude Code/Desktop muss das "stdio" sein)
MCP_MODE=stdio

# Logging
LOG_LEVEL=error
DISABLE_CONSOLE_OUTPUT=true
